<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo library access is required to scan and back up your photos and videos to your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Local network access is required to connect to your Mac for backup.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_icherri._tcp</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.icherri.ios.auto-backup.processing</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
