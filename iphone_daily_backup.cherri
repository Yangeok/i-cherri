/*
수정일시: 2026-05-20 13:31:19 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (숫자 추출 기반 강제 매칭 - 수정)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

action 'downloadurl' dynamicJSONRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFJSONValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "JSON"
}

action 'downloadurl' dynamicFormRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFFormValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "Form"
}

comment('수정일시: 2026-05-20 13:31:19 KST')

@serverBase: text
@serverBase = "http://192.168.0.101:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

@healthURL: text
@healthURL = "{@serverBase}/health"

@selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")

@targetISO = formatDate(@selectedDate, "ISO 8601")
@targetDay: text
@targetDay = replaceText("[^0-9]", "", @targetISO, true, true)
@targetDayArray = splitText(@targetDay, "")
@targetDay8 = getListItems(@targetDayArray, 1, 8)
@targetFinal: text
@targetFinal = joinText(@targetDay8, "")

@healthResponse = downloadURL(@healthURL)
@healthText: text
@healthText = getText(@healthResponse)
showNotification("헬스 응답: {@healthText}", "iPhone Daily Backup", false)

@pingResponse = jsonRequest(@checkURL, "POST", {
    "original_name": "__ping__",
    "created_at": "2000-01-01T00:00:00+09:00",
    "file_size": 0
})
@pingDict = getDictionary(@pingResponse)
@pingExistsValue = getValue(@pingDict, "exists")
@pingExistsText: text
@pingExistsText = "{@pingExistsValue}"
showNotification("서버 응답 확인: {@pingExistsText}", "iPhone Daily Backup", false)

@previousDate = adjustDate(@selectedDate, "Subtract", qty(1, "days"))
@prevISO = formatDate(@previousDate, "ISO 8601")
@prevDay: text
@prevDay = replaceText("[^0-9]", "", @prevISO, true, true)
@prevDayArray = splitText(@prevDay, "")
@prevDay8 = getListItems(@prevDayArray, 1, 8)
@prevFinal: text
@prevFinal = joinText(@prevDay8, "")

@scanCount = 500

@latestPhotos = getLatestPhotos(@scanCount, true)
@photoCount = count(@latestPhotos)
@photoSeenSelectedDay: bool
@photoSeenSelectedDay = false
@matchedPhotoCount: number
@matchedPhotoCount = 0
@photoUploadSentCount: number
@photoUploadSentCount = 0
@photoStop: bool
@photoStop = false

@debugLog: text
@debugLog = "Target: [{@targetFinal}]\n"

repeat i for @photoCount {
    if !@photoStop {
        @photoItem = getListItem(@latestPhotos, @i)

        @pTakenVal = getImageDetail(@photoItem, "Date Taken")
        @pTakenISO = formatDate(@pTakenVal, "ISO 8601")
        @pTakenNum = replaceText("[^0-9]", "", @pTakenISO, true, true)
        @pTakenArray = splitText(@pTakenNum, "")
        @pTaken8 = getListItems(@pTakenArray, 1, 8)
        @pTakenDay: text
        @pTakenDay = joinText(@pTaken8, "")

        @pCreatedVal = getImageDetail(@photoItem, "Creation Date")
        @pCreatedISO = formatDate(@pCreatedVal, "ISO 8601")
        @pCreatedNum = replaceText("[^0-9]", "", @pCreatedISO, true, true)
        @pCreatedArray = splitText(@pCreatedNum, "")
        @pCreated8 = getListItems(@pCreatedArray, 1, 8)
        @pCreatedDay: text
        @pCreatedDay = joinText(@pCreated8, "")

        @pMatch: bool
        @pMatch = false
        if @pTakenDay == @targetFinal {
            @pMatch = true
        }
        if @pCreatedDay == @targetFinal {
            @pMatch = true
        }

        if @i <= 3 {
            @debugLog = "{@debugLog}P{@i}: T=[{@pTakenDay}] M={@pMatch}\n"
        }

        if @pMatch {
            if !@photoSeenSelectedDay {
                showNotification("사진 매칭 성공: {@pTakenDay}", "iPhone Daily Backup", false)
            }
            @photoSeenSelectedDay = true
            @matchedPhotoCount = @matchedPhotoCount + 1

            @pNameVal = getImageDetail(@photoItem, "Name")
            @pName: text
            @pName = "{@pNameVal}"

            @pMetadataISO: text
            @pMetadataISO = getText(@pTakenISO)
            if @pTakenDay != @targetFinal {
                @pCreatedISOText = formatDate(@pCreatedVal, "ISO 8601")
                @pMetadataISO = getText(@pCreatedISOText)
            }

            @pSizeVal = getImageDetail(@photoItem, "File Size")
            @pSize: text
            @pSize = "{@pSizeVal}"

            @pCheckRes = jsonRequest(@checkURL, "POST", {
                "original_name": "{@pName}",
                "created_at": "{@pMetadataISO}",
                "file_size": "{@pSize}"
            })
            @pCheckDict = getDictionary(@pCheckRes)
            @pExistsVal = getValue(@pCheckDict, "exists")
            @pExistsText: text
            @pExistsText = "{@pExistsVal}"

            if @pExistsText == "false" {
                @pUploadBody = {}
                @pUploadBody = setValue(@pUploadBody, "file", @photoItem)
                @pUploadBody = setValue(@pUploadBody, "original_name", @pName)
                @pUploadBody = setValue(@pUploadBody, "created_at", @pMetadataISO)
                @pUploadBody = setValue(@pUploadBody, "file_size", @pSize)
                dynamicFormRequest(@uploadURL, "POST", @pUploadBody)
                @photoUploadSentCount = @photoUploadSentCount + 1
            }
        }

        @pPrevMatch: bool
        @pPrevMatch = false
        if @pTakenDay == @prevFinal {
            @pPrevMatch = true
        }
        if @pCreatedDay == @prevFinal {
            @pPrevMatch = true
        }

        if @photoSeenSelectedDay {
            if @pPrevMatch {
                @photoStop = true
            }
        }
    }
}

@latestVideos = getLatestVideos(@scanCount)
@videoCount = count(@latestVideos)
@videoSeenSelectedDay: bool
@videoSeenSelectedDay = false
@matchedVideoCount: number
@matchedVideoCount = 0
@videoUploadSentCount: number
@videoUploadSentCount = 0
@videoStop: bool
@videoStop = false

repeat j for @videoCount {
    if !@videoStop {
        @vItem = getListItem(@latestVideos, @j)

        @vTakenVal = getImageDetail(@vItem, "Date Taken")
        @vTakenISO = formatDate(@vTakenVal, "ISO 8601")
        @vTakenNum = replaceText("[^0-9]", "", @vTakenISO, true, true)
        @vTakenArray = splitText(@vTakenNum, "")
        @vTaken8 = getListItems(@vTakenArray, 1, 8)
        @vTakenDay: text
        @vTakenDay = joinText(@vTaken8, "")

        @vCreatedVal = getImageDetail(@vItem, "Creation Date")
        @vCreatedISO = formatDate(@vCreatedVal, "ISO 8601")
        @vCreatedNum = replaceText("[^0-9]", "", @vCreatedISO, true, true)
        @vCreatedArray = splitText(@vCreatedNum, "")
        @vCreated8 = getListItems(@vCreatedArray, 1, 8)
        @vCreatedDay: text
        @vCreatedDay = joinText(@vCreated8, "")

        @vMatch: bool
        @vMatch = false
        if @vTakenDay == @targetFinal {
            @vMatch = true
        }
        if @vCreatedDay == @targetFinal {
            @vMatch = true
        }

        if @j <= 3 {
            @debugLog = "{@debugLog}V{@j}: T=[{@vTakenDay}] M={@vMatch}\n"
        }

        if @vMatch {
            if !@videoSeenSelectedDay {
                showNotification("영상 매칭 성공: {@vTakenDay}", "iPhone Daily Backup", false)
            }
            @videoSeenSelectedDay = true
            @matchedVideoCount = @matchedVideoCount + 1

            @vNameVal = getImageDetail(@vItem, "Name")
            @vName: text
            @vName = "{@vNameVal}"

            @vMetadataISO: text
            @vMetadataISO = getText(@vTakenISO)
            if @vTakenDay != @targetFinal {
                @vCreatedISOText = formatDate(@vCreatedVal, "ISO 8601")
                @vMetadataISO = getText(@vCreatedISOText)
            }

            @vSizeVal = getImageDetail(@vItem, "File Size")
            @vSize: text
            @vSize = "{@vSizeVal}"

            @vCheckRes = jsonRequest(@checkURL, "POST", {
                "original_name": "{@vName}",
                "created_at": "{@vMetadataISO}",
                "file_size": "{@vSize}"
            })
            @vCheckDict = getDictionary(@vCheckRes)
            @vExistsVal = getValue(@vCheckDict, "exists")
            @vExistsText: text
            @vExistsText = "{@vExistsVal}"

            if @vExistsText == "false" {
                @vUploadBody = {}
                @vUploadBody = setValue(@vUploadBody, "file", @vItem)
                @vUploadBody = setValue(@vUploadBody, "original_name", @vName)
                @vUploadBody = setValue(@vUploadBody, "created_at", @vMetadataISO)
                @vUploadBody = setValue(@vUploadBody, "file_size", @vSize)
                dynamicFormRequest(@uploadURL, "POST", @vUploadBody)
                @videoUploadSentCount = @videoUploadSentCount + 1
            }
        }

        @vPrevMatch: bool
        @vPrevMatch = false
        if @vTakenDay == @prevFinal {
            @vPrevMatch = true
        }
        if @vCreatedDay == @prevFinal {
            @vPrevMatch = true
        }

        if @videoSeenSelectedDay {
            if @vPrevMatch {
                @videoStop = true
            }
        }
    }
}

show("{@debugLog}\nResult:\nselected={@targetFinal}\nphotos_matched={@matchedPhotoCount}\nphotos_uploaded={@photoUploadSentCount}\nvideos_matched={@matchedVideoCount}\nvideos_uploaded={@videoUploadSentCount}")
