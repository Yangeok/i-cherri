/*
수정일시: 2026-05-20 14:31:44 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (IP 하드코딩 및 표준 전송 - 재수정)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

// 수동으로 Form 전송 규격을 정의하여 Cherri 한계 우회
action 'downloadurl' rawFormUpload(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFFormValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "Form"
}

comment('수정일시: 2026-05-20 14:31:44 KST')

// 서버 IP 하드코딩 (프롬프트 제거)
@serverIP: text
@serverIP = "192.168.0.101"
@serverBase: text
@serverBase = "http://{@serverIP}:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

@selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")
@targetDay: text
@targetDay = formatDate(@selectedDate, "Custom", "yyyy-MM-dd")

@scanCount = 100
@matchedCount: number
@matchedCount = 0
@uploadedCount: number
@uploadedCount = 0

@latestItems = getLatestPhotos(@scanCount, true)
@totalCount = count(@latestItems)

repeat i for @totalCount {
    @item = getListItem(@latestItems, @i)

    @pTakenVal = getImageDetail(@item, "Date Taken")
    @pDate: text
    @pDate = formatDate(@pTakenVal, "Custom", "yyyy-MM-dd")
    
    if @pDate == @targetDay {
        @matchedCount = @matchedCount + 1
        
        @pNameVal = getImageDetail(@item, "Name")
        @pName: text
        @pName = "{@pNameVal}"
        
        @pISOVal = formatDate(@pTakenVal, "ISO 8601")
        @pISO: text
        @pISO = getText(@pISOVal)
        
        @pSizeVal = getImageDetail(@item, "File Size")
        @pSize: text
        @pSize = "{@pSizeVal}"

        // 1. 중복 체크
        @pCheckRes = jsonRequest(@checkURL, "POST", {
            "original_name": "{@pName}",
            "created_at": "{@pISO}",
            "file_size": "{@pSize}"
        })
        @pCheckDict = getDictionary(@pCheckRes)
        @pExValue = getValue(@pCheckDict, "exists")
        @pExStr: text
        @pExStr = "{@pExValue}"

        // 로케일 대응 체크
        @isExists: bool
        @isExists = true
        if @pExStr == "false" { @isExists = false }
        if @pExStr == "nein" { @isExists = false }
        if @pExStr == "No" { @isExists = false }
        
        if !@isExists {
            // 2. 업로드 (가장 확실한 Form 규격 사용)
            @uBody = {}
            @uBody = setValue(@uBody, "file", @item)
            @uBody = setValue(@uBody, "original_name", @pName)
            @uBody = setValue(@uBody, "created_at", @pISO)
            @uBody = setValue(@uBody, "file_size", @pSize)
            
            @uRes = rawFormUpload(@uploadURL, "POST", @uBody, {})
            
            @uDict = getDictionary(@uRes)
            @uOKVal = getValue(@uDict, "ok")
            @uOKStr: text
            @uOKStr = "{@uOKVal}"
            
            if @uOKStr == "true" {
                @uploadedCount = @uploadedCount + 1
            }
        }
    }
}

show("Final Result:\nTarget: {@targetDay}\nMatched: {@matchedCount}\nUploaded: {@uploadedCount}")
