/*
수정일시: 2026-05-20 13:25:42 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (타입 명시 및 ISO 기반 매칭)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

action 'downloadurl' dynamicJSONRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFJSONValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "JSON"
}

action 'downloadurl' dynamicFormRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFFormValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "Form"
}

comment('수정일시: 2026-05-20 13:25:42 KST')

@serverBase: text
@serverBase = "http://192.168.0.101:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

@healthURL: text
@healthURL = "{@serverBase}/health"

@selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")

@selectedISO: text
@selectedISO = formatDate(@selectedDate, "ISO 8601")
@selectedParts: array
@selectedParts = splitText(@selectedISO, "T")
@selectedDay: text
@selectedDay = getFirstItem(@selectedParts)

@healthResponse = downloadURL(@healthURL)
@healthText: text
@healthText = getText(@healthResponse)
showNotification("헬스 응답: {@healthText}", "iPhone Daily Backup", false)

@pingResponse = jsonRequest(@checkURL, "POST", {
    "original_name": "__ping__",
    "created_at": "2000-01-01T00:00:00+09:00",
    "file_size": 0
})
@pingDict = getDictionary(@pingResponse)
@pingExistsValue = getValue(@pingDict, "exists")
@pingExistsText: text
@pingExistsText = "{@pingExistsValue}"
showNotification("서버 응답 확인: {@pingExistsText}", "iPhone Daily Backup", false)

@previousDate = adjustDate(@selectedDate, "Subtract", qty(1, "days"))
@previousISO: text
@previousISO = formatDate(@previousDate, "ISO 8601")
@previousParts: array
@previousParts = splitText(@previousISO, "T")
@previousDay: text
@previousDay = getFirstItem(@previousParts)

@scanCount = 500

@latestPhotos = getLatestPhotos(@scanCount, true)
@photoCount = count(@latestPhotos)
@photoSeenSelectedDay: bool
@photoSeenSelectedDay = false
@matchedPhotoCount: number
@matchedPhotoCount = 0
@photoUploadSentCount: number
@photoUploadSentCount = 0
@photoStop: bool
@photoStop = false

@debugLog: text
@debugLog = "Selected: [{@selectedDay}]\n"

repeat i for @photoCount {
    if !@photoStop {
        @photoItem = getListItem(@latestPhotos, @i)

        @photoTakenValue = getImageDetail(@photoItem, "Date Taken")
        @photoTakenISO: text
        @photoTakenISO = formatDate(@photoTakenValue, "ISO 8601")
        @photoTakenParts: array
        @photoTakenParts = splitText(@photoTakenISO, "T")
        @photoTakenDay: text
        @photoTakenDay = getFirstItem(@photoTakenParts)

        @photoCreatedValue = getImageDetail(@photoItem, "Creation Date")
        @photoCreatedISO: text
        @photoCreatedISO = formatDate(@photoCreatedValue, "ISO 8601")
        @photoCreatedParts: array
        @photoCreatedParts = splitText(@photoCreatedISO, "T")
        @photoCreatedDay: text
        @photoCreatedDay = getFirstItem(@photoCreatedParts)

        @photoMatchesSelectedDay: bool
        @photoMatchesSelectedDay = false
        if @photoTakenDay == @selectedDay {
            @photoMatchesSelectedDay = true
        }
        if @photoCreatedDay == @selectedDay {
            @photoMatchesSelectedDay = true
        }

        if @i <= 3 {
            @debugLog = "{@debugLog}P{@i}: T=[{@photoTakenDay}] Match:{@photoMatchesSelectedDay}\n"
        }

        if @photoMatchesSelectedDay {
            if !@photoSeenSelectedDay {
                showNotification("사진 매칭성공: {@photoTakenDay}", "iPhone Daily Backup", false)
            }
            @photoSeenSelectedDay = true
            @matchedPhotoCount = @matchedPhotoCount + 1

            @photoNameValue = getImageDetail(@photoItem, "Name")
            @photoName: text
            @photoName = "{@photoNameValue}"

            @photoMetadataDateISO: text
            @photoMetadataDateISO = @photoTakenISO
            if @photoTakenDay != @selectedDay {
                @photoMetadataDateISO = @photoCreatedISO
            }

            @photoFileSizeValue = getImageDetail(@photoItem, "File Size")
            @photoFileSize: text
            @photoFileSize = "{@photoFileSizeValue}"

            @photoCheckResponse = jsonRequest(@checkURL, "POST", {
                "original_name": "{@photoName}",
                "created_at": "{@photoMetadataDateISO}",
                "file_size": "{@photoFileSize}"
            })
            @photoCheckDict = getDictionary(@photoCheckResponse)
            @photoExistsValue = getValue(@photoCheckDict, "exists")
            @photoExistsText: text
            @photoExistsText = "{@photoExistsValue}"

            if @photoExistsText == "false" {
                @photoUploadBody = {}
                @photoUploadBody = setValue(@photoUploadBody, "file", @photoItem)
                @photoUploadBody = setValue(@photoUploadBody, "original_name", @photoName)
                @photoUploadBody = setValue(@photoUploadBody, "created_at", @photoMetadataDateISO)
                @photoUploadBody = setValue(@photoUploadBody, "file_size", @photoFileSize)
                dynamicFormRequest(@uploadURL, "POST", @photoUploadBody)
                @photoUploadSentCount = @photoUploadSentCount + 1
            }
        }

        @photoMatchesPreviousDay: bool
        @photoMatchesPreviousDay = false
        if @photoTakenDay == @previousDay {
            @photoMatchesPreviousDay = true
        }
        if @photoCreatedDay == @previousDay {
            @photoMatchesPreviousDay = true
        }

        if @photoSeenSelectedDay {
            if @photoMatchesPreviousDay {
                @photoStop = true
            }
        }
    }
}

@latestVideos = getLatestVideos(@scanCount)
@videoCount = count(@latestVideos)
@videoSeenSelectedDay: bool
@videoSeenSelectedDay = false
@matchedVideoCount: number
@matchedVideoCount = 0
@videoUploadSentCount: number
@videoUploadSentCount = 0
@videoStop: bool
@videoStop = false

repeat j for @videoCount {
    if !@videoStop {
        @videoItem = getListItem(@latestVideos, @j)

        @videoTakenValue = getImageDetail(@videoItem, "Date Taken")
        @videoTakenISO: text
        @videoTakenISO = formatDate(@videoTakenValue, "ISO 8601")
        @videoTakenParts: array
        @videoTakenParts = splitText(@videoTakenISO, "T")
        @videoTakenDay: text
        @videoTakenDay = getFirstItem(@videoTakenParts)

        @videoCreatedValue = getImageDetail(@videoItem, "Creation Date")
        @videoCreatedISO: text
        @videoCreatedISO = formatDate(@videoCreatedValue, "ISO 8601")
        @videoCreatedParts: array
        @videoCreatedParts = splitText(@videoCreatedISO, "T")
        @videoCreatedDay: text
        @videoCreatedDay = getFirstItem(@videoCreatedParts)

        @videoMatchesSelectedDay: bool
        @videoMatchesSelectedDay = false
        if @videoTakenDay == @selectedDay {
            @videoMatchesSelectedDay = true
        }
        if @videoCreatedDay == @selectedDay {
            @videoMatchesSelectedDay = true
        }

        if @j <= 3 {
            @debugLog = "{@debugLog}V{@j}: T=[{@videoTakenDay}] Match:{@videoMatchesSelectedDay}\n"
        }

        if @videoMatchesSelectedDay {
            if !@videoSeenSelectedDay {
                showNotification("영상 매칭성공: {@videoTakenDay}", "iPhone Daily Backup", false)
            }
            @videoSeenSelectedDay = true
            @matchedVideoCount = @matchedVideoCount + 1

            @videoNameValue = getImageDetail(@videoItem, "Name")
            @videoName: text
            @videoName = "{@videoNameValue}"

            @videoMetadataDateISO: text
            @videoMetadataDateISO = @videoTakenISO
            if @videoTakenDay != @selectedDay {
                @videoMetadataDateISO = @videoCreatedISO
            }

            @videoFileSizeValue = getImageDetail(@videoItem, "File Size")
            @videoFileSize: text
            @videoFileSize = "{@videoFileSizeValue}"

            @videoCheckResponse = jsonRequest(@checkURL, "POST", {
                "original_name": "{@videoName}",
                "created_at": "{@videoMetadataDateISO}",
                "file_size": "{@videoFileSize}"
            })
            @videoCheckDict = getDictionary(@videoCheckResponse)
            @videoExistsValue = getValue(@videoCheckDict, "exists")
            @videoExistsText: text
            @videoExistsText = "{@videoExistsValue}"

            if @videoExistsText == "false" {
                @videoUploadBody = {}
                @videoUploadBody = setValue(@videoUploadBody, "file", @videoItem)
                @videoUploadBody = setValue(@videoUploadBody, "original_name", @videoName)
                @videoUploadBody = setValue(@videoUploadBody, "created_at", @videoMetadataDateISO)
                @videoUploadBody = setValue(@videoUploadBody, "file_size", @videoFileSize)
                dynamicFormRequest(@uploadURL, "POST", @videoUploadBody)
                @videoUploadSentCount = @videoUploadSentCount + 1
            }
        }

        @videoMatchesPreviousDay: bool
        @videoMatchesPreviousDay = false
        if @videoTakenDay == @previousDay {
            @videoMatchesPreviousDay = true
        }
        if @videoCreatedDay == @previousDay {
            @videoMatchesPreviousDay = true
        }

        if @videoSeenSelectedDay {
            if @videoMatchesPreviousDay {
                @videoStop = true
            }
        }
    }
}

show("{@debugLog}\nResult:\nselected={@selectedDay}\nphotos_matched={@matchedPhotoCount}\nphotos_uploaded={@photoUploadSentCount}\nvideos_matched={@matchedVideoCount}\nvideos_uploaded={@videoUploadSentCount}")
