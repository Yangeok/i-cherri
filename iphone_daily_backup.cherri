/*
수정일시: 2026-05-21 15:13:30 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (사진+영상, filter.photos 네이티브 쿼리)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

comment('수정일시: 2026-05-21 15:13:30 KST')

@serverIP: text
@serverIP = "MacBook-Pro-Intel.local"
@serverBase: text
@serverBase = "http://{@serverIP}:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

// ShortcutInput이 있으면 자동화 날짜, 없으면 날짜 선택 프롬프트
@inputCount: number
@inputCount = count(ShortcutInput)

@targetDate: date

if @inputCount > 0 {
    @targetDate = ShortcutInput
} else {
    @targetDate = prompt("업로드할 날짜를 선택하세요", "Date")
}

// 날짜 범위: [startDate, endDate)
@startDate: date
@startDate = adjustDate(@targetDate, "Get Start of Day")
@endDate: date
@endDate = adjustDate(@startDate, "Add", qty(1, "days"))

@targetDay: text
@targetDay = formatDate(@startDate, "Custom", "yyyy-MM-dd")

// filter.photos: UUID는 setvariable이 출력을 참조하기 위해 필요
@allMedia: variable
rawAction("is.workflow.actions.filter.photos", {
    "UUID": "cafe0001-beef-dead-0000-123456789abc",
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 1003,
                    "Property": "Creation Date",
                    "Removable": true,
                    "Values": {
                        "AnotherDate": {
                            "Value": {
                                "Type": "Variable",
                                "VariableName": "endDate"
                            },
                            "WFSerializationType": "WFTextTokenAttachment"
                        },
                        "Date": {
                            "Value": {
                                "Type": "Variable",
                                "VariableName": "startDate"
                            },
                            "WFSerializationType": "WFTextTokenAttachment"
                        },
                        "Unit": 4
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemLimitEnabled": false
})
rawAction("is.workflow.actions.setvariable", {
    "WFVariableName": "allMedia",
    "WFInput": {
        "Value": {
            "OutputName": "Filter Photos",
            "OutputUUID": "cafe0001-beef-dead-0000-123456789abc",
            "Type": "ActionOutput"
        },
        "WFSerializationType": "WFTextTokenAttachment"
    }
})

@totalCount = count(@allMedia)
@uploadedCount: number
@uploadedCount = 0

// check → upload 단일 루프 (addtovariable rawAction 제거)
repeat i for @totalCount {
    @item = getListItem(@allMedia, @i)

    @pNameVal = getImageDetail(@item, "Name")
    @pName: text
    @pName = "{@pNameVal}"

    @pTakenVal = getImageDetail(@item, "Creation Date")
    @pISOVal = formatDate(@pTakenVal, "ISO 8601")
    @pISO = "{@pISOVal}"

    @pCheckRes = jsonRequest(@checkURL, "POST", {
        "original_name": "{@pName}",
        "created_at": "{@pISO}"
    })
    @checkDict = getDictionary(@pCheckRes)
    @existsVal = getValue(@checkDict, "exists")
    @existsStr: text
    @existsStr = "{@existsVal}"

    @shouldUpload: bool
    @shouldUpload = true
    if @existsStr == "true" {
        @shouldUpload = false
    }

    if @shouldUpload {
        @pISOEncoded = urlEncode("{@pISO}")
        @metaURL: text
        @metaURL = "{@uploadURL}?original_name={@pName}&created_at={@pISOEncoded}"
        rawAction("is.workflow.actions.downloadurl", {
            "WFURL": "{@metaURL}",
            "WFHTTPMethod": "POST",
            "WFHTTPBodyType": "File",
            "WFRequestVariable": "${item}"
        })
        @uploadedCount = @uploadedCount + 1
    }
}

show("Final Result:\nTarget: {@targetDay}\nTotal: {@totalCount}\nUploaded: {@uploadedCount}")
