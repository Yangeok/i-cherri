/*
수정일시: 2026-05-21 14:06:26 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (사진+영상, filter.photos 네이티브 쿼리)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

comment('수정일시: 2026-05-21 14:06:26 KST')

@serverIP: text
@serverIP = "192.168.0.101"
@serverBase: text
@serverBase = "http://{@serverIP}:8787"

@checkBatchURL: text
@checkBatchURL = "{@serverBase}/check-batch"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

// ShortcutInput이 있으면 자동화 날짜, 없으면 날짜 선택 프롬프트
@hasInput: bool
@hasInput = false
if ShortcutInput {
    @hasInput = true
}

@targetDay: text

if @hasInput {
    @targetDay = formatDate(ShortcutInput, "Custom", "yyyy-MM-dd")
}
@shouldPrompt: bool
@shouldPrompt = true
if @hasInput {
    @shouldPrompt = false
}
if @shouldPrompt {
    @selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")
    @targetDay = formatDate(@selectedDate, "Custom", "yyyy-MM-dd")
}

// 날짜 범위: [startDate, endDate)
@startDate: date
@startDate = date("{@targetDay}")
@endDate: date
@endDate = adjustDate(@startDate, "Add", qty(1, "days"))

// filter.photos: Photos 라이브러리 레벨에서 날짜 필터 (사진+영상 통합)
// is.workflow.actions.filter.photos 를 standalone rawAction + setvariable 체인으로 출력 캡처
@allMedia: variable
rawAction("is.workflow.actions.filter.photos", {
    "UUID": "cafe0001-beef-dead-0000-123456789abc",
    "CustomOutputName": "FilteredMedia",
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 1003,
                    "Property": "Creation Date",
                    "Removable": true,
                    "Values": {
                        "Date": {
                            "Value": {
                                "Type": "Variable",
                                "VariableName": "startDate"
                            },
                            "WFSerializationType": "WFTextTokenAttachment"
                        },
                        "AnotherDate": {
                            "Value": {
                                "Type": "Variable",
                                "VariableName": "endDate"
                            },
                            "WFSerializationType": "WFTextTokenAttachment"
                        },
                        "Unit": 4
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemSortProperty": "Creation Date",
    "WFContentItemSortOrder": "Latest First",
    "WFContentItemLimitEnabled": false
})
rawAction("is.workflow.actions.setvariable", {
    "WFVariableName": "allMedia",
    "WFInput": {
        "Value": {
            "OutputName": "FilteredMedia",
            "OutputUUID": "cafe0001-beef-dead-0000-123456789abc",
            "Type": "ActionOutput"
        },
        "WFSerializationType": "WFTextTokenAttachment"
    }
})

@totalCount = count(@allMedia)
@matchedCount: number
@matchedCount = @totalCount
@uploadedCount: number
@uploadedCount = 0

@batchList: variable

// 1. 모든 미디어 메타데이터 수집 루프
repeat i for @totalCount {
    @item = getListItem(@allMedia, @i)

    @pNameVal = getImageDetail(@item, "Name")
    @pName: text
    @pName = "{@pNameVal}"

    @pTakenVal = getImageDetail(@item, "Creation Date")
    @pISOVal = formatDate(@pTakenVal, "ISO 8601")
    @pISO: text
    @pISO = getText(@pISOVal)

    @fileMeta = {
        "original_name": "{@pName}",
        "created_at": "{@pISO}"
    }
    rawAction("is.workflow.actions.addtovariable", {
        "WFVariableName": "batchList",
        "WFInput": "${fileMeta}"
    })
}

// 2. 일괄 중복 체크 요청
@pCheckRes = jsonRequest(@checkBatchURL, "POST", {
    "files": "${batchList}"
})
@checkMap = getDictionary(@pCheckRes)

// 3. 필터링 및 실제 업로드 루프
repeat i for @totalCount {
    @item = getListItem(@allMedia, @i)

    @pNameVal = getImageDetail(@item, "Name")
    @pName: text
    @pName = "{@pNameVal}"

    @pTakenVal = getImageDetail(@item, "Creation Date")
    @pISOVal = formatDate(@pTakenVal, "ISO 8601")
    @pISO: text
    @pISO = getText(@pISOVal)

    // 조합 키 대조: "파일명|생성일"
    @mapKey: text
    @mapKey = "{@pName}|{@pISO}"
    @mapKeyClean = replaceText(".", "_", @mapKey)

    @pExValue = getValue(@checkMap, "{@mapKeyClean}")
    @pExStr: text
    @pExStr = "{@pExValue}"

    @shouldUpload: bool
    @shouldUpload = true
    if @pExStr == "true" {
        @shouldUpload = false
    }
    if @pExStr == "1" {
        @shouldUpload = false
    }
    if @pExStr == "Yes" {
        @shouldUpload = false
    }
    if @pExStr == "예" {
        @shouldUpload = false
    }
    if @pExStr == "Ja" {
        @shouldUpload = false
    }

    if @shouldUpload {
        @pISOEncoded = urlEncode("{@pISO}")
        @metaURL: text
        @metaURL = "{@uploadURL}?original_name={@pName}&created_at={@pISOEncoded}"
        rawAction("is.workflow.actions.downloadurl", {
            "WFURL": "{@metaURL}",
            "WFHTTPMethod": "POST",
            "WFHTTPBodyType": "File",
            "WFRequestVariable": "${item}"
        })
        @uploadedCount = @uploadedCount + 1
    }
}

show("Final Result:\nTarget: {@targetDay}\nMatched: {@matchedCount}\nUploaded: {@uploadedCount}")
