/*
수정일시: 2026-05-20 13:51:21 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (변수 참조 및 매칭 최종 수정)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

action 'downloadurl' dynamicJSONRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFJSONValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "JSON"
}

action 'downloadurl' dynamicFormRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFFormValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "Form"
}

comment('수정일시: 2026-05-20 13:51:21 KST')

@serverBase: text
@serverBase = "http://192.168.0.101:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

@healthURL: text
@healthURL = "{@serverBase}/health"

@selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")
@targetDay: text
@targetDay = formatDate(@selectedDate, "Custom", "yyyy-MM-dd")

@healthResponse = downloadURL(@healthURL)
@healthText: text
@healthText = getText(@healthResponse)
showNotification("헬스 응답: {@healthText}", "iPhone Daily Backup", false)

@pingResponse = jsonRequest(@checkURL, "POST", {
    "original_name": "__ping__",
    "created_at": "2000-01-01T00:00:00+09:00",
    "file_size": 0
})
@pingDict = getDictionary(@pingResponse)
@pingExistsValue = getValue(@pingDict, "exists")
@pingExistsStr: text
@pingExistsStr = "{@pingExistsValue}"
showNotification("서버 응답 확인: {@pingExistsStr}", "iPhone Daily Backup", false)

@scanCount = 100
@matchedCount: number
@matchedCount = 0
@uploadedCount: number
@uploadedCount = 0

@latestItems = getLatestPhotos(@scanCount, true)
@totalCount = count(@latestItems)

repeat i for @totalCount {
    @item = getListItem(@latestItems, @i)

    @pTakenVal = getImageDetail(@item, "Date Taken")
    @pDate: text
    @pDate = formatDate(@pTakenVal, "Custom", "yyyy-MM-dd")
    
    if @pDate == @targetDay {
        @matchedCount = @matchedCount + 1
        
        @pNameVal = getImageDetail(@item, "Name")
        @pName: text
        @pName = "{@pNameVal}"
        
        @pISOVal = formatDate(@pTakenVal, "ISO 8601")
        @pISO: text
        @pISO = getText(@pISOVal)
        
        @pSizeVal = getImageDetail(@item, "File Size")
        @pSize: text
        @pSize = "{@pSizeVal}"

        @pCheckRes = jsonRequest(@checkURL, "POST", {
            "original_name": "{@pName}",
            "created_at": "{@pISO}",
            "file_size": "{@pSize}"
        })
        @pCheckDict = getDictionary(@pCheckRes)
        @pExValue = getValue(@pCheckDict, "exists")
        @pExStr: text
        @pExStr = "{@pExValue}"

        if @pExStr == "false" {
            @pUploadBody = {}
            @pUploadBody = setValue(@pUploadBody, "file", @item)
            @pUploadBody = setValue(@pUploadBody, "original_name", @pName)
            @pUploadBody = setValue(@pUploadBody, "created_at", @pISO)
            @pUploadBody = setValue(@pUploadBody, "file_size", @pSize)
            dynamicFormRequest(@uploadURL, "POST", @pUploadBody)
            @uploadedCount = @uploadedCount + 1
        }
    }
}

show("Result: Matched={@matchedCount}, Uploaded={@uploadedCount}")
