/*
수정일시: 2026-05-20 13:27:44 KST
설명: Go LAN 서버용 iPhone Daily 증분 백업 (초강력 문자열 기반 날짜 매칭)
*/

#include 'actions/photos'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/web'
#include 'actions/scripting'
#include 'actions/text'

#define name iPhone Daily Backup
#define glyph folder
#define color blue
#define mac false

action 'downloadurl' dynamicJSONRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFJSONValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "JSON"
}

action 'downloadurl' dynamicFormRequest(
    text url: 'WFURL',
    HTTPMethod ?method: 'WFHTTPMethod',
    variable body: 'WFFormValues',
    dictionary! ?headers: 'WFHTTPHeaders'
) {
    "WFHTTPBodyType": "Form"
}

comment('수정일시: 2026-05-20 13:27:44 KST')

@serverBase: text
@serverBase = "http://192.168.0.101:8787"

@checkURL: text
@checkURL = "{@serverBase}/check"

@uploadURL: text
@uploadURL = "{@serverBase}/upload"

@healthURL: text
@healthURL = "{@serverBase}/health"

@selectedDate = prompt("업로드할 날짜를 선택하세요", "Date")

// 비교용 날짜 문자열 생성 (yyyyMMdd 형식, 순수 텍스트 추출)
@targetDayRaw = formatDate(@selectedDate, "Custom", "yyyyMMdd")
@targetDay: text
@targetDay = getText(@targetDayRaw)

@healthResponse = downloadURL(@healthURL)
@healthText: text
@healthText = getText(@healthResponse)
showNotification("헬스 응답: {@healthText}", "iPhone Daily Backup", false)

@pingResponse = jsonRequest(@checkURL, "POST", {
    "original_name": "__ping__",
    "created_at": "2000-01-01T00:00:00+09:00",
    "file_size": 0
})
@pingDict = getDictionary(@pingResponse)
@pingExistsValue = getValue(@pingDict, "exists")
@pingExistsText: text
@pingExistsText = "{@pingExistsValue}"
showNotification("서버 응답 확인: {@pingExistsText}", "iPhone Daily Backup", false)

@previousDate = adjustDate(@selectedDate, "Subtract", qty(1, "days"))
@prevDayRaw = formatDate(@previousDate, "Custom", "yyyyMMdd")
@prevDay: text
@prevDay = getText(@prevDayRaw)

@scanCount = 500

@latestPhotos = getLatestPhotos(@scanCount, true)
@photoCount = count(@latestPhotos)
@photoSeenSelectedDay: bool
@photoSeenSelectedDay = false
@matchedPhotoCount: number
@matchedPhotoCount = 0
@photoUploadSentCount: number
@photoUploadSentCount = 0
@photoStop: bool
@photoStop = false

@debugLog: text
@debugLog = "Target: [{@targetDay}]\n"

repeat i for @photoCount {
    if !@photoStop {
        @photoItem = getListItem(@latestPhotos, @i)

        @pTakenVal = getImageDetail(@photoItem, "Date Taken")
        @pTakenDayRaw = formatDate(@pTakenVal, "Custom", "yyyyMMdd")
        @pTakenDay: text
        @pTakenDay = getText(@pTakenDayRaw)

        @pCreatedVal = getImageDetail(@photoItem, "Creation Date")
        @pCreatedDayRaw = formatDate(@pCreatedVal, "Custom", "yyyyMMdd")
        @pCreatedDay: text
        @pCreatedDay = getText(@pCreatedDayRaw)

        @pMatch: bool
        @pMatch = false
        if @pTakenDay == @targetDay {
            @pMatch = true
        }
        if @pCreatedDay == @targetDay {
            @pMatch = true
        }

        if @i <= 5 {
            @debugLog = "{@debugLog}P{@i}: T={@pTakenDay} C={@pCreatedDay} M={@pMatch}\n"
        }

        if @pMatch {
            if !@photoSeenSelectedDay {
                showNotification("사진 매칭 성공: {@pTakenDay}", "iPhone Daily Backup", false)
            }
            @photoSeenSelectedDay = true
            @matchedPhotoCount = @matchedPhotoCount + 1

            @pNameVal = getImageDetail(@photoItem, "Name")
            @pName: text
            @pName = "{@pNameVal}"

            @pISO = formatDate(@pTakenVal, "ISO 8601")
            @pMetadataISO: text
            @pMetadataISO = getText(@pISO)
            if @pTakenDay != @targetDay {
                @pISO2 = formatDate(@pCreatedVal, "ISO 8601")
                @pMetadataISO = getText(@pISO2)
            }

            @pSizeVal = getImageDetail(@photoItem, "File Size")
            @pSize: text
            @pSize = "{@pSizeVal}"

            @pCheckRes = jsonRequest(@checkURL, "POST", {
                "original_name": "{@pName}",
                "created_at": "{@pMetadataISO}",
                "file_size": "{@pSize}"
            })
            @pCheckDict = getDictionary(@pCheckRes)
            @pExistsVal = getValue(@pCheckDict, "exists")
            @pExistsText: text
            @pExistsText = "{@pExistsVal}"

            if @pExistsText == "false" {
                @pUploadBody = {}
                @pUploadBody = setValue(@pUploadBody, "file", @photoItem)
                @pUploadBody = setValue(@pUploadBody, "original_name", @pName)
                @pUploadBody = setValue(@pUploadBody, "created_at", @pMetadataISO)
                @pUploadBody = setValue(@pUploadBody, "file_size", @pSize)
                dynamicFormRequest(@uploadURL, "POST", @pUploadBody)
                @photoUploadSentCount = @photoUploadSentCount + 1
            }
        }

        @pPrevMatch: bool
        @pPrevMatch = false
        if @pTakenDay == @prevDay {
            @pPrevMatch = true
        }
        if @pCreatedDay == @prevDay {
            @pPrevMatch = true
        }

        if @photoSeenSelectedDay {
            if @pPrevMatch {
                @photoStop = true
            }
        }
    }
}

@latestVideos = getLatestVideos(@scanCount)
@videoCount = count(@latestVideos)
@videoSeenSelectedDay: bool
@videoSeenSelectedDay = false
@matchedVideoCount: number
@matchedVideoCount = 0
@videoUploadSentCount: number
@videoUploadSentCount = 0
@videoStop: bool
@videoStop = false

repeat j for @videoCount {
    if !@videoStop {
        @vItem = getListItem(@latestVideos, @j)

        @vTakenVal = getImageDetail(@vItem, "Date Taken")
        @vTakenDayRaw = formatDate(@vTakenVal, "Custom", "yyyyMMdd")
        @vTakenDay: text
        @vTakenDay = getText(@vTakenDayRaw)

        @vCreatedVal = getImageDetail(@vItem, "Creation Date")
        @vCreatedDayRaw = formatDate(@vCreatedVal, "Custom", "yyyyMMdd")
        @vCreatedDay: text
        @vCreatedDay = getText(@vCreatedDayRaw)

        @vMatch: bool
        @vMatch = false
        if @vTakenDay == @targetDay {
            @vMatch = true
        }
        if @vCreatedDay == @targetDay {
            @vMatch = true
        }

        if @j <= 5 {
            @debugLog = "{@debugLog}V{@j}: T={@vTakenDay} C={@vCreatedDay} M={@vMatch}\n"
        }

        if @vMatch {
            if !@videoSeenSelectedDay {
                showNotification("영상 매칭 성공: {@vTakenDay}", "iPhone Daily Backup", false)
            }
            @videoSeenSelectedDay = true
            @matchedVideoCount = @matchedVideoCount + 1

            @vNameVal = getImageDetail(@vItem, "Name")
            @vName: text
            @vName = "{@vNameVal}"

            @vISO = formatDate(@vTakenVal, "ISO 8601")
            @vMetadataISO: text
            @vMetadataISO = getText(@vISO)
            if @vTakenDay != @targetDay {
                @vISO2 = formatDate(@vCreatedVal, "ISO 8601")
                @vMetadataISO = getText(@vISO2)
            }

            @vSizeVal = getImageDetail(@vItem, "File Size")
            @vSize: text
            @vSize = "{@vSizeVal}"

            @vCheckRes = jsonRequest(@checkURL, "POST", {
                "original_name": "{@vName}",
                "created_at": "{@vMetadataISO}",
                "file_size": "{@vSize}"
            })
            @vCheckDict = getDictionary(@vCheckRes)
            @vExistsVal = getValue(@vCheckDict, "exists")
            @vExistsText: text
            @vExistsText = "{@vExistsVal}"

            if @vExistsText == "false" {
                @vUploadBody = {}
                @vUploadBody = setValue(@vUploadBody, "file", @vItem)
                @vUploadBody = setValue(@vUploadBody, "original_name", @vName)
                @vUploadBody = setValue(@vUploadBody, "created_at", @vMetadataISO)
                @vUploadBody = setValue(@vUploadBody, "file_size", @vSize)
                dynamicFormRequest(@uploadURL, "POST", @vUploadBody)
                @videoUploadSentCount = @videoUploadSentCount + 1
            }
        }

        @vPrevMatch: bool
        @vPrevMatch = false
        if @vTakenDay == @prevDay {
            @vPrevMatch = true
        }
        if @vCreatedDay == @prevDay {
            @vPrevMatch = true
        }

        if @videoSeenSelectedDay {
            if @vPrevMatch {
                @videoStop = true
            }
        }
    }
}

show("{@debugLog}\nResult:\nselected={@targetDay}\nphotos_matched={@matchedPhotoCount}\nphotos_uploaded={@photoUploadSentCount}\nvideos_matched={@matchedVideoCount}\nvideos_uploaded={@videoUploadSentCount}")
